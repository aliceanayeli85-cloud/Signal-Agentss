# ============================================================================
# MemeTrader OS - environment configuration
#
# Copy to .env and edit. EVERY value here is optional: the app runs with no .env
# file at all, using the on-chain and crypto data sources that need no key.
# ============================================================================

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=5199
HOST=127.0.0.1
# Vite dev server port (client). Only used by `npm run dev`.
CLIENT_PORT=5173
# debug | info | warn | error
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# SQLite file. Created automatically, along with any missing directories.
DATABASE_PATH=./data/memetrader.db

# ---------------------------------------------------------------------------
# Data fetching
# ---------------------------------------------------------------------------
# How long a provider response is reused before being refetched, in ms.
# GeckoTerminal allows roughly 30 requests/minute, so do not set this too low.
DATA_CACHE_TTL_MS=20000
# Age at which the UI labels data STALE, in ms.
DATA_STALE_AFTER_MS=60000
# Per-request timeout for upstream data providers, in ms.
HTTP_TIMEOUT_MS=12000

# ---------------------------------------------------------------------------
# AI analysis (OPTIONAL)
#
# Without a key the AI panel reports itself unavailable and every other feature
# works normally. Get a key at https://console.anthropic.com/
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Stock / ETF data (OPTIONAL)
#
# Stock market data is not free. Without one of these keys the Stocks scanner
# tab and stock symbols in Day Trade mode report DATA UNAVAILABLE with the
# reason, rather than showing an empty chart.
#
# Alpha Vantage free tier: ~25 requests/day. https://www.alphavantage.co/support/#api-key
# Polygon.io free tier: delayed data, rate limited. https://polygon.io/dashboard/signup
# ---------------------------------------------------------------------------
# ALPHA_VANTAGE_API_KEY=
# POLYGON_API_KEY=

# ---------------------------------------------------------------------------
# Safety switch
#
# There is NO real-money execution code anywhere in this repository: no wallet
# connection, no transaction signing, no exchange order placement. This flag
# exists so any future execution integration must be turned on deliberately.
# The server REFUSES TO START if it is set to true, because there is nothing
# for it to enable.
# ---------------------------------------------------------------------------
ENABLE_LIVE_TRADING=false
