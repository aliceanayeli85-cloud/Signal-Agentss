{
  "name": "fba-research-desk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local Amazon FBA product research and profitability calculator. All fees are user-entered; nothing is invented.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:artifact": "tsc --noEmit && vite build --mode artifact",
    "start": "npm run build && vite preview --host 127.0.0.1 --port 4180 --strictPort",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
