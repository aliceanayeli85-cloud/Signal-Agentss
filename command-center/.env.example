# Trading Command Center — copy to .env and fill in. Every value is optional
# except the Alpaca keys, without which no prices are shown.

# --- Market data (required for prices) -------------------------------------
# Free account at https://alpaca.markets — generate keys in the dashboard.
# Only market data and the market clock are read. No orders are ever sent.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# iex = free real-time feed (IEX exchange only). Real-time sip needs a paid plan.
ALPACA_FEED=iex
# Daily candles from the consolidated feed (free when ≥15 min old). Matches the research data.
ALPACA_DAILY_FEED=sip

# --- Server ------------------------------------------------------------------
PORT=5299
# 127.0.0.1 = only this computer. To reach it from your phone (e.g. on Replit)
# use 0.0.0.0 AND set ACCESS_TOKEN — the server refuses to start otherwise.
HOST=127.0.0.1
# ACCESS_TOKEN=use-a-long-random-string
DATABASE_PATH=./data/command-center.db

# --- Monitor -------------------------------------------------------------------
# true: the web server also runs the monitor. false: run `npm run monitor` separately.
MONITOR_IN_PROCESS=true
# How often prices are checked while the market is open / closed (seconds).
MONITOR_INTERVAL_SECONDS=60
MONITOR_OFF_HOURS_INTERVAL_SECONDS=900

# --- Phone notifications (optional) ------------------------------------------
# Install the free ntfy app, subscribe to a hard-to-guess topic, put its URL here.
# Anyone who knows the topic name can read it, so keep it secret.
# NTFY_URL=https://ntfy.sh/your-long-secret-topic-name

# --- Safety ----------------------------------------------------------------------
# There is no live order code. Setting this to true stops the server from starting.
ENABLE_LIVE_TRADING=false
